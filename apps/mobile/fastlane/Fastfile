# fastlane lanes for ChallengeBu (App Store Connect automation).
# Secrets come from env vars — nothing sensitive is committed here.

default_platform(:ios)

platform :ios do
  # Authenticate Spaceship with the App Store Connect API key (env-driven).
  private_lane :asc_auth do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false,
    )
  end

  # Upload the App Privacy (data-collection) details from app_privacy_details.json.
  #   ASC_KEY_ID=... ASC_ISSUER_ID=... ASC_KEY_PATH=/path/AuthKey.p8 fastlane privacy
  lane :privacy do
    asc_auth
    upload_app_privacy_details_to_app_store(
      app_identifier: "app.challengebu.ios",
      json_path: "fastlane/app_privacy_details.json",
      skip_json_file_saving: true,
    )
  end

  # Push TEXT metadata only (name/subtitle/description/keywords/promo/release
  # notes/review notes) to App Store Connect. Deliberately skips screenshots and
  # the binary: screenshots must be regenerated after any UI copy rename and
  # uploaded separately, and the binary ships via EAS. No submission is made.
  #
  # PASS version: — `eas submit` only uploads the binary to TestFlight, it does
  # NOT create the App Store version. Without an app_version deliver looks for
  # an already-editable version, finds none once the previous one is live, and
  # burns its whole retry ladder on "Cannot find edit app store version".
  # Naming the version makes deliver create it.
  #   ASC_KEY_ID=... ASC_ISSUER_ID=... ASC_KEY_PATH=/path/AuthKey.p8 \
  #     fastlane metadata version:1.1.1
  lane :metadata do |options|
    asc_auth
    deliver(
      app_identifier: "app.challengebu.ios",
      app_version: options[:version],
      metadata_path: "fastlane/metadata",
      skip_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end

  # Upload ONLY screenshots (skipping text metadata and the binary). Reads
  # every PNG under fastlane/screenshots/<lang>/<Device>/ and overwrites the
  # matching slot on the target version.
  #
  # Takes version: for the same reason `metadata` does — see the note there.
  #   ASC_KEY_ID=... ASC_ISSUER_ID=... ASC_KEY_PATH=/path/AuthKey.p8 \
  #     fastlane screenshots version:1.1.1
  lane :screenshots do |options|
    asc_auth
    deliver(
      app_identifier: "app.challengebu.ios",
      app_version: options[:version],
      screenshots_path: "fastlane/screenshots",
      skip_screenshots: false,
      overwrite_screenshots: true,
      skip_metadata: true,
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end

  # Create/select an App Store version, ATTACH a finished (already-uploaded via
  # EAS) build to it, and push text metadata onto that version. Screenshots and
  # the binary upload are skipped; no review submission is made. The build must
  # have finished Apple processing first.
  #   ASC_KEY_ID=... ASC_ISSUER_ID=... ASC_KEY_PATH=... fastlane release version:1.1.0 build:13
  lane :release do |options|
    asc_auth
    deliver(
      app_identifier: "app.challengebu.ios",
      app_version: options[:version],
      build_number: options[:build],
      metadata_path: "fastlane/metadata",
      skip_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end
end
