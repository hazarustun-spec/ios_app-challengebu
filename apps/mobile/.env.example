EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Sentry — leave empty for a dev/opt-out build (init becomes a no-op).
# Create the project at sentry.io, copy the DSN, paste it here (dev) and
# add it as EXPO_PUBLIC_SENTRY_DSN in EAS Secrets for production builds.
# The DSN is not a secret (it identifies the project, not authenticates a
# request), so it is safe to commit — this file is a template only.
EXPO_PUBLIC_SENTRY_DSN=

# Source-map upload (build-time only, never ships in the bundle). Add as
# EAS Secrets under the production environment:
#   SENTRY_AUTH_TOKEN=sntrys_...
#   SENTRY_ORG=your-org
#   SENTRY_PROJECT=challengebu-mobile
